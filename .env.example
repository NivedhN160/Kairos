# Server Configuration (Render automatically sets PORT)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# Single-Service Hosting (Recommended for Render free tier)
# If true, runs the ingestion and clustering workers in background asyncio tasks
# within the web service process, so no separate paid background workers are needed!
RUN_EMBEDDED_WORKERS=true

# Database & Broker
# For Render / Cloud ($0 free tier):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/kairos?ssl=require
# REDIS_URL=rediss://default:token@xyz.upstash.io:6379
# If not provided, Kairos falls back to local SQLite + in-memory broker for instant zero-dependency testing!
DATABASE_URL=
REDIS_URL=

# Pipeline Configuration
PIPELINE_VERSION=v1.0.0
FETCH_CONCURRENCY=5
DEFAULT_POLL_INTERVAL=60

# Free-Tier LLM APIs (Optional - for enhanced summaries and briefings)
GEMINI_API_KEY=
GROQ_API_KEY=
